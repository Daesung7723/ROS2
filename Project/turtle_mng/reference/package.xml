<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_first_pkg</name>
  <version>0.1.0</version>
  <description>turtlesim 을 제어하는 명령행 도구 모음 — ROS2·Python 학습용 독립 미니프로젝트</description>
  <maintainer email="daesung7723@gmail.com">Daesung Kim</maintainer>
  <license>MIT</license>

  <!-- 실행 시 필요한 패키지. 선언하지 않으면 내 컴퓨터에서만 동작하는 패키지가 된다 (Day 3 §5). -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
